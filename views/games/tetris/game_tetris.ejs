<%- include('../../partials/header') %>

    <!DOCTYPE html>
    <html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Gamebar - Tetris</title>
        <style>
            #gameCanvas {
                height: 75vmin;
                width: 75vmin/2;
                position: absolute;
                top: 52%;
                left: 50%;
                transform: translate(-50%, -50%);
                outline: 1px solid #4d664d;
            }
        </style>
    </head>
    <%- include('../../partials/gameSessions') %>

        <body>
            <canvas id="gameCanvas" width="1000" height="2000" style="border:1px solid #d3d3d3;"></canvas>
        </body>
        <script>
            const canvas = document.getElementById('gameCanvas');
            const ctx = canvas.getContext('2d');

            const piece1 = new Image();
            piece1.src = '/tetris/piece1.png';
            const piece2 = new Image();
            piece2.src = '/tetris/piece2.png';
            const piece3 = new Image();
            piece3.src = '/tetris/piece3.png';
            const piece4 = new Image();
            piece4.src = '/tetris/piece4.png';
            const piece5 = new Image();
            piece5.src = '/tetris/piece5.png';
            const piece6 = new Image();
            piece6.src = '/tetris/piece6.png';
            const piece7 = new Image();
            piece7.src = '/tetris/piece7.png';

            const board = Array.from({ length: 20 }, () => Array(10).fill(0));

            let spawn = true;
            let tetris;
            let x = 0;
            let y = 0;
            let move = 0;
            function gameloop() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                ctx.fillStyle = '#000000';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                if (spawn) {
                    tetris = [piece1, piece2, piece3, piece4, piece5, piece6, piece7][Math.floor(Math.random() * 7)];
                    x = 3;
                    y = 0;
                    spawn = false;
                } else {
                    move += 1;
                    if (move >= 30) {
                        y += 1;
                        move = 0;
                    }
                }



                // if (y >= 18 && !tetris === piece7) {
                //     spawn = true;
                // } else if (y >= 19) {
                //     spawn = true;
                // }
                // if (x < 0 && !tetris !== piece4) {
                //     x = 0;
                // } else if (x < -1) {
                //     x = -1;
                // }
                // if (x > 6 && tetris === piece7) {
                //     x = 6;
                // } else if (x > 7) {
                //     x = 7;
                // }
                ctx.drawImage(tetris, x * 100, y * 100, 100 * 4, 100 * 2);

                requestAnimationFrame(gameloop);
            }
            gameloop();

            document.addEventListener('keydown', (event) => {
                if (event.key === 'ArrowLeft') {
                    x -= 1;
                } else if (event.key === 'ArrowRight') {
                    x += 1;
                } else if (event.key === 'ArrowDown') {
                    y += 1;
                } else if (event.key === 'ArrowUp') {
                    // Rotate the piece (not implemented yet)
                }
            });
        </script>

    </html>